param(
    [Parameter(Mandatory=$true)][string]$ProjectPath,
    [Parameter(Mandatory=$true)][string]$OutDir,
    [string]$PitchCsv = '',
    [int]$StepTimeoutSeconds = 3,
    [string]$RepoRoot = 'H:\KeyenceAgent\kv-studio-operator'
)
# 轴登记收尾：把「批量登录轴」之后的所有确认/向导处理干净，并保存。
# 输入一律 Win32 + PostMessage（不取前台 ✓）；保存优先 UIA 点「保存」按钮 ✓。
$ErrorActionPreference = 'Stop'
Add-Type -AssemblyName UIAutomationClient
Add-Type -AssemblyName UIAutomationTypes
. (Join-Path (Split-Path -Parent (Split-Path -Parent $PSCommandPath)) 'kv_dialog_post.ps1')
$null = New-Item -ItemType Directory -Force -Path $OutDir
$log = Join-Path $OutDir 'run.log'
function W([string]$m){
    $line = (Get-Date).ToString('HH:mm:ss.fff') + '  ' + $m
    Write-Host $line
    Add-Content -LiteralPath $log -Value $line -Encoding UTF8
}
$proc = Get-Process -Name 'Kvs' -ErrorAction SilentlyContinue | Select-Object -First 1
if (-not $proc) { throw 'KV_AXIS_REG_NO_KVS' }
W ('kvs pid=' + $proc.Id + ' project=' + $ProjectPath)
function Get-VisibleWindows([int]$procId) { Get-KvTopWindow -ProcessId $procId -VisibleOnly }
function Get-UiaRoot([IntPtr]$hwnd) { try { return [System.Windows.Automation.AutomationElement]::FromHandle($hwnd) } catch { return $null } }
function Get-ButtonIn([IntPtr]$hwnd, [string]$pattern) {
    $root = Get-UiaRoot $hwnd
    if (-not $root) { return $null }
    foreach ($el in @($root.FindAll([System.Windows.Automation.TreeScope]::Descendants, [System.Windows.Automation.Condition]::TrueCondition))) {
        if ([string]$el.Current.ControlType.ProgrammaticName -ne 'ControlType.Button') { continue }
        $nm = ''
        try { $nm = [string]$el.Current.Name } catch { continue }
        if ($nm -match $pattern) { return $el }
    }
    return $null
}
function Click-ButtonIn([IntPtr]$hwnd, [string]$pattern, [string]$tag) {
    $root = Get-UiaRoot $hwnd
    if (-not $root) { return $false }
    foreach ($el in @($root.FindAll([System.Windows.Automation.TreeScope]::Descendants, [System.Windows.Automation.Condition]::TrueCondition))) {
        $ct = ''
        try { $ct = [string]$el.Current.ControlType.ProgrammaticName } catch { continue }
        if ($ct -ne 'ControlType.Button' -and $ct -ne 'ControlType.MenuItem') { continue }
        $nm = ''
        try { $nm = [string]$el.Current.Name } catch { continue }
        if ($nm -notmatch $pattern) { continue }
        # 优先 UIA Invoke ✓（菜单项/按钮都支持 ✓），失败再 PostMessage ✓
        try {
            $el.GetCurrentPattern([System.Windows.Automation.InvokePattern]::Pattern).Invoke()
            W ('invoke ' + $tag + ' [' + $nm + '] (' + $ct + ')')
            Start-Sleep -Milliseconds 600
            return $true
        } catch {
            $h = [IntPtr]0
            try { $h = [IntPtr]$el.Current.NativeWindowHandle } catch { }
            if ($h -ne [IntPtr]0) {
                [void](Invoke-KvButtonPost -ButtonHwnd $h -Tag $tag)
                return $true
            }
        }
    }
    return $false
}
function Wait-Prompt([string]$pattern, [int]$seconds, [string]$tag) {
    try { return Wait-KvDialogButton -ProcessId $proc.Id -TextPattern $pattern -TimeoutSeconds $seconds -Tag $tag } catch { return $null }
}

# 步骤 1/2：前面的弹窗（可能已被上游点掉 ✓ → 有则点、无则跳过 ✓）
$d = Wait-Prompt '^\s*OK\s*$' $StepTimeoutSeconds 'batch-axis'
if ($d) { W 'batch-axis dialog present'; [void](Invoke-KvButtonPost -ButtonHwnd $d.ButtonHwnd -Tag 'batch-axis') } else { W 'batch-axis dialog absent -> skip' }
$d = Wait-Prompt '^确定$' $StepTimeoutSeconds 'login-done'
if ($d) { W 'login-done dialog present'; [void](Invoke-KvButtonPost -ButtonHwnd $d.ButtonHwnd -Tag 'login-done') } else { W 'login-done dialog absent -> skip' }

# 步骤 3：这个提示**每根轴弹一次** ✓ → 循环「点 是(Y) → 退出该轴向导 → 点退出确认」
# 固化步骤 ✓：先把每根轴的螺距填好并「执行计算」（这是最初验证过的做法 ✓）
# 不填就会出现「存在没有计算的轴，是否停止向导？」✗
if ($PitchCsv) {
  $Pitches = @($PitchCsv -split ',' | ForEach-Object { $_.Trim() } | Where-Object { $_ })
  $fillScript = Join-Path (Split-Path -Parent $PSCommandPath) 'fill_axis_pitches.ps1'
  if ((Test-Path $fillScript) -and $Pitches.Count -gt 0) {
    try { & powershell -NoProfile -ExecutionPolicy Bypass -File $fillScript -ProcessId $proc.Id -Pitches $Pitches -StepTimeoutSeconds $StepTimeoutSeconds 2>&1 | ForEach-Object { W ('fill: ' + $_) } } catch { W ('fill failed: ' + $_.Exception.Message) }
  }
}

for ($ax = 1; $ax -le 6; $ax++) {
    $d = Wait-Prompt '是' $StepTimeoutSeconds ('confirm-' + $ax)
    if (-not $d) { W ('no confirm prompt for axis ' + $ax + ' -> done'); break }
    W ('axis ' + $ax + ' prompt [' + $d.ButtonText + ']')
    [void](Invoke-KvButtonPost -ButtonHwnd $d.ButtonHwnd -Tag ('confirm-' + $ax))
    $wz = $null
    $wzEnd = (Get-Date).AddSeconds(6)
    do {
        foreach ($win in (Get-VisibleWindows $proc.Id)) {
            if ($win.Title -match '坐标转换计算') { $wz = $win; break }
        }
        if ($wz) { break }
        Start-Sleep -Milliseconds 150
    } while ((Get-Date) -lt $wzEnd)
    if (-not $wz) { W ('axis ' + $ax + ' wizard not shown'); continue }
    W ('axis ' + $ax + ' wizard [' + $wz.Title + ']')
    [void](Click-ButtonIn $wz.Hwnd '退出向导' ('exit-wizard-' + $ax))
    $cf = Wait-Prompt '是' 3 ('exit-confirm-' + $ax)
    if ($cf) { [void](Invoke-KvButtonPost -ButtonHwnd $cf.ButtonHwnd -Tag ('exit-confirm-' + $ax)) } else { W 'exit confirm absent' }
}

# 步骤 4：保存（优先 UIA 点主窗口的「保存」按钮 ✓ 不需要前台 ✓）
$mainWin = $null
foreach ($win in (Get-VisibleWindows $proc.Id)) { if ($win.Title -match '^KV STUDIO\s*-\s*\[') { $mainWin = $win; break } }
if (-not $mainWin) { throw 'KV_AXIS_REG_MAIN_WINDOW_NOT_FOUND' }
$saved = Click-ButtonIn $mainWin.Hwnd '保存' 'save-button'
if (-not $saved) {
    W 'save button not found -> guard Ctrl+S fallback'
    $guardBody = @"
`$ErrorActionPreference='Continue'
Add-Type -AssemblyName System.Windows.Forms
. 'REPO\guards\kv_ui_guard.ps1'
`$null = Initialize-KvUiGuard -OutDir 'OUT\save'
Invoke-KvGuardedSendKeys -TargetHwnd ([IntPtr]HW) -Step 'save axis registration' -Keys '^s' -ExpectedTitleLike 'KV STUDIO*' -SleepMs 3500
"@
    $scriptsRoot = Split-Path -Parent (Split-Path -Parent $PSCommandPath)
    $guardBody = $guardBody.Replace('REPO', $scriptsRoot).Replace('OUT', $OutDir).Replace('HW', [string]$mainWin.Hwnd.ToInt64())
    $gp = Join-Path $OutDir 'guard_save.ps1'
    [IO.File]::WriteAllText($gp, $guardBody, (New-Object System.Text.UTF8Encoding($false)))
    try { & powershell -NoProfile -ExecutionPolicy Bypass -File $gp 2>&1 | ForEach-Object { W ('guard-save: ' + $_) } } catch { W ('guard-save failed: ' + $_.Exception.Message) }
    $global:LASTEXITCODE = 0
}
Start-Sleep -Seconds 2
$title = ''
try { $title = [string](Get-Process -Id $proc.Id).MainWindowTitle } catch { }
W ('title after save = [' + $title + ']')
$result = [ordered]@{
    ok = ($title -notmatch '\*')
    project_path = $ProjectPath
    title_after_save = $title
    foreground_calls = 0
    note = 'dialogs/wizard via Win32 PostMessage; save via UIA save button; no foreground calls'
}
$result | ConvertTo-Json -Depth 4 | Set-Content -LiteralPath (Join-Path $OutDir 'axis_registration_result.json') -Encoding UTF8
if (-not $result.ok) { throw 'KV_AXIS_REG_SAVE_DIRTY' }
W 'done'
exit 0